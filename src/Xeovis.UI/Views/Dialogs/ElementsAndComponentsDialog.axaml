<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        Width="900"
        Height="600"
        MinWidth="900"
        MinHeight="600"
        x:Class="Xeovis.UI.Views.Dialogs.ElementsAndComponentsDialog"
        xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
        xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
        Title="Settings | Elements &amp; Components">

    <Window.Styles>
        <StyleInclude Source="/Views/Styles/Dialogs.axaml" />
        <StyleInclude Source="/Views/Styles/Buttons.axaml" />
        <StyleInclude Source="/Views/Styles/Textboxes.axaml" />

        <Style Selector="Border.AddSection">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0 5 0 0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,50"
          Margin="15">

        <Grid Grid.Row="0"
              ColumnDefinitions="200,1*">

            <!-- Elements -->
            <Grid Grid.Column="0"
                  Margin="0 0 5 0"
                  RowDefinitions="*, 80">

                <userControls:LabelListControl Grid.Row="0" x:Name="llcElements" />

                <!-- Add New Element -->
                <Border Grid.Row="1"
                        Classes="AddSection">
                    <Grid ColumnDefinitions="*, 20">
                        <userControls:LabelInputControl Grid.Column="0"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Stretch"
                                                        x:Name="licNewElement"
                                                        Margin="0 0 5 0"
                                                        MinWidth="60" />
                        <Button Grid.Column="1"
                                Classes="InLine"
                                Margin="0 20"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                x:Name="btnAddElement"
                                ToolTip.Tip="Add New Element"
                                HorizontalContentAlignment="Center">
                            <Button.Content>
                                <Image Source="/Assets/add.png" Width="16" Height="16" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

            </Grid>

            <!-- Components -->
            <Grid Grid.Column="1"
                  Margin="5 0"
                  RowDefinitions="30,*, 80">
                <TextBlock Grid.Row="0"
                           Text="Components with Associated Elements"
                           VerticalAlignment="Bottom"
                           Margin="0 5" />
                <userControls:TableControl Grid.Row="1"
                                           x:Name="tableComponents" />

                <!-- Add New Component -->
                <Border Grid.Row="2"
                        Classes="AddSection">
                    <Grid ColumnDefinitions="230, 20, 20, 280">
                        <userControls:LabelInputControl Grid.Column="0"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Stretch"
                                                        x:Name="licNewComponent"
                                                        Margin="0 0 5 0"
                                                        MinWidth="60" />
                        <Button Grid.Column="1"
                                Classes="InLine"
                                Margin="0 20"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                x:Name="btnAddComponent"
                                ToolTip.Tip="Add New Component"
                                HorizontalContentAlignment="Center">
                            <Button.Content>
                                <Image Source="/Assets/add.png" Width="16" Height="16" />
                            </Button.Content>
                        </Button>

                        <Rectangle Grid.Column="2"
                                   Width="2"
                                   Height="60"
                                   Fill="LightGray"
                                   Margin="5 0"
                                   VerticalAlignment="Stretch" />

                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="Selected Component Options" />
                            <Grid ColumnDefinitions="1*,1*,1*">
                                <Button Grid.Column="0" Classes="Primary"
                                        Width="80"
                                        x:Name="btnRemoveComponent"
                                        Content="Remove" />
                                
                                <Button Grid.Column="1" Classes="Primary"
                                        Width="90"
                                        x:Name="btnMoveUpComponent"
                                        Content="Move Up" />
                                
                                <Button Grid.Column="2" Classes="Primary"
                                        Width="90"
                                        x:Name="btnMoveDownComponent"
                                        Content="Move Down" />
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1*,1*">

            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="5">

                <Button x:Name="btnProjectDefaults"
                        Content="Project Defaults"
                        Width="120"
                        Classes="Primary" />
                
                <Button x:Name="btnXeovisDefaults"
                        Content="Xeovis Defaults"
                        Width="120"
                        Classes="Primary" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="5">

                <Button x:Name="btnCancel" Classes="Primary" Content="Cancel" IsCancel="True" />
                <Button x:Name="btnSave" Classes="Primary" Content="Save" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>