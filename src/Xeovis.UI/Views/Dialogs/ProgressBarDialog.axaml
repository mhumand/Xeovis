<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
		Width="400"
		Height="200"
        x:Class="Xeovis.UI.ProgressBarDialog"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Loading..."
		CanResize="False">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/ProgressBars.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
	</Window.Styles>

	<Grid RowDefinitions="*,40" Margin="15">
		<StackPanel Grid.Row="0"
					VerticalAlignment="Center">
			<TextBlock x:Name="txtPrimary"
					   HorizontalAlignment="Center"/>
			<ProgressBar  x:Name="pbPrimary"
						  Classes="Primary"/>

			<TextBlock x:Name="txtSecondary"
					   Margin="0,10,0,0"
					   HorizontalAlignment="Center"/>
			<ProgressBar  x:Name="pbSecondary"
						  Classes="Secondary"/>
		</StackPanel>

		<Button x:Name="btnCancel"
				Grid.Row="1"
				HorizontalAlignment="Right"
				Content="Cancel"
				Click="btnCancel_Click"
				Classes="Primary"/>
	</Grid>

</Window>
