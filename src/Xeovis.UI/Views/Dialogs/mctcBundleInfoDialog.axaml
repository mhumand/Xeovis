<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        Width="800"
        Height="700"
        MinWidth="500"
        MinHeight="500"
        x:Class="Xeovis.UI.Views.Dialogs.mctcBundleInfoDialog"
        xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
        xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
        Title="MCTC - Bundle Info">

    <Window.Styles>
        <StyleInclude Source="/Views/Styles/Dialogs.axaml" />
        <StyleInclude Source="/Views/Styles/Buttons.axaml" />
        <StyleInclude Source="/Views/Styles/Textboxes.axaml" />
        
        <Style Selector="Expander">
            <Setter Property="Padding"  Value="10"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,50" Margin="15 10">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">

            <StackPanel x:Name="ExpandersContainer" Spacing="5">

                <!-- General -->
                <Expander HorizontalAlignment="Stretch"
                          x:Name="expanderGeneral"
                          Header="General"
                          IsExpanded="True"
                          Expanded="Expander_Expanded">

                    <StackPanel Spacing="10">
                        
                        <!-- Bundle Name and Color -->
                        <Grid ColumnDefinitions="*,*" Height="60">
                            <userControls:LabelInputControl Grid.Column="0"
                                                            VerticalAlignment="Top"
                                                            x:Name="licName" HorizontalAlignment="Left" />
                            
                            <StackPanel Grid.Column="1" Spacing="0"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Color" />
                                <ColorPicker x:Name="colorPicker"/>
                            </StackPanel>
                            
                        </Grid>
                        
                        <!-- Bundle Directory -->
                        <Grid ColumnDefinitions="*,30">
                            <userControls:LabelBrowseDirectoryControl Grid.Column="0" x:Name="lbdcDirectory" />
                            <Button Grid.Column="1"
                                    x:Name="btnRestoreDirectory"
                                    Margin="5 5"
                                    ToolTip.Tip="Restore"
                                    VerticalAlignment="Bottom"
                                    Classes="InLine">
                                <Button.Content>
                                    <Image Width="16" Height="16" Source="/Assets/Chart/ZoomReset.png" />
                                </Button.Content>
                            </Button>
                        </Grid>
                        
                        
                    </StackPanel>
                </Expander>

                <!-- Batches -->
                <Expander HorizontalAlignment="Stretch"
                          x:Name="expanderBatches"
                          Header="Batches"
                          Expanded="Expander_Expanded">
                    <ScrollViewer>
                        <userControls:TableControl x:Name="tableBatches"
                                                   Height="300"/>
                    </ScrollViewer>
                </Expander>

                <!-- x-eos Variables -->
                <Expander HorizontalAlignment="Stretch"
                          x:Name="expanderXeosVariables"
                          Header="x-eos Variables"
                          Expanded="Expander_Expanded">
                    
                    <StackPanel Spacing="5">
                        <userControls:LabelComboBoxControl x:Name="cmbxBatch"
                                                           HorizontalAlignment="Left"
                                                           Width="450"/>
                        <ScrollViewer>
                            <userControls:TableControl x:Name="tableXeosVariables" Height="300" />
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
                
                <!-- mctc Variabels -->
                <Expander HorizontalAlignment="Stretch"
                          x:Name="expanderMctcVariables"
                          Header="mctc Variables"
                          Expanded="Expander_Expanded">
                    <ScrollViewer>
                        <userControls:TableControl x:Name="tableMctcVariables" Height="300" />
                    </ScrollViewer>
                </Expander>


            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid ColumnDefinitions="*, 150">
                <userControls:CheckBoxControl Grid.Column="0"
                                              VerticalAlignment="Bottom"
                                              x:Name="ckbxSingleExpansion"/>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="5">
                    <Button x:Name="btnCancel" Classes="Primary" Content="Cancel" />
                    <Button x:Name="btnSave" Classes="Primary" Content="Save" />
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>

</Window>