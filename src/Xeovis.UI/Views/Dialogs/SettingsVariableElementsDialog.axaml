<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
		MinHeight="400"
		MinWidth="600"
		Height="500"
		Width="900"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
		xmlns:vmc="using:Xeovis.UI.ViewModels"
		x:DataType="vm:SettingsVariableElementsViewModel"
        x:Class="Xeovis.UI.SettingsVariableElementsDialog"
        Title="Settings | x-eos Variable Elements">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>
	</Window.Styles>


	<Grid Margin="20 10" RowDefinitions="*, 40">

		<userControls:TableControl x:Name="tableControl"
								   Grid.Row="0"/>

		<Grid Grid.Row="1" ColumnDefinitions="1*,1*">

			<StackPanel Grid.Column="0"
						Spacing="10"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Left"
						Orientation="Horizontal">

				<Button x:Name="btnProjectDefaults"
						Classes="Primary"
						Width="120"
						Click="btnProjectDefaults_Click"
						Content="Project Defaults"/>
				<Button x:Name="btnXeovisDefaults"
						Classes="Primary"
						Width="120"
						Click="btnXeovisDefaults_Click"
						Content="Xeovis Defaults"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
						Grid.Column="1"
						Spacing="10"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Right">

				<Button x:Name="btnCancel"
						Classes="Primary"
						Content="Cancel"
						IsCancel="True"
						Click="btnCancel_Click"/>

				<Button x:Name="btnSave"
						Classes="Primary"
						Content="Save"
						Click="btnSave_Click"/>

			</StackPanel>

		</Grid>

	</Grid>



</Window>
