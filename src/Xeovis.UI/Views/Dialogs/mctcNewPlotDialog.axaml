<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
		MinHeight="400"
		MinWidth="600"
		Height="600"
		Width="800"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
		xmlns:vmc="using:Xeovis.UI.ViewModels"
		x:DataType="vm:mctcNewPlotViewModel"
        x:Class="Xeovis.UI.mctcNewPlotDialog"
        Title="MCTC - New Plot">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>

		<Style Selector="Border.Custom">
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Margin" Value="5 0"/>
			<Setter Property="Padding" Value="5 0"/>
		</Style>
		
		<Style Selector="Button.Reorder">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="5, 0"/>
			<Setter Property="Padding" Value="5, 5"/>
		</Style>
	</Window.Styles>

	<DockPanel Margin="15">

		<!-- Top Section - name + mctc bundle -->
		<Border DockPanel.Dock="Top"
		        Classes="Custom"
		        Padding="10"
		        BorderBrush="Gray">
			<Grid ColumnDefinitions="1*,1*"
			      Height="70">
				<userControls:LabelInputControl Grid.Column="0"
				                                x:Name="txtName"
				                                Margin="5 0 5 10"
				                                DockPanel.Dock="Top"
				                                HorizontalAlignment="Left"
				                                VerticalAlignment="Top"
				                                Width="250"/>
		
				<userControls:LabelComboBoxControl Grid.Column="1"
				                                   x:Name="lcbcMctcBundles"
				                                   Margin="5 0"
				                                   DockPanel.Dock="Top"
				                                   Width="250"
				                                   HorizontalAlignment="Left"
				                                   VerticalAlignment="Top"/>
			</Grid>
		</Border>


		<!-- Middle Section - Label List Controls -->
		<Grid DockPanel.Dock="Top"
			  VerticalAlignment="Stretch"
			  Margin="0,10,0,0"
			  ColumnDefinitions="2*,1*"
			  RowDefinitions="*,50">

			<Border Grid.Row="0"
			        Classes="Custom"
					Grid.Column="0"
					BorderBrush="#1C39BB">

				<Grid ColumnDefinitions="1*,1*">
					<userControls:LabelListControl x:Name="llcPhase"
												   Grid.Column="0"
												   Margin="5"/>
					<userControls:LabelListControl x:Name="llcXeosVariables"
												   Grid.Column="1"
												   Margin="5"/>
				</Grid>

			</Border>

			<!-- Selected Variables -->
			<Border Grid.Row="0"
			        Classes="Custom"
			        Grid.Column="1"
			        BorderBrush="Gray">
				<Grid RowDefinitions="*,40">
					<userControls:LabelListControl Grid.Row="0"
					                               x:Name="llcSelected"
					                               DockPanel.Dock="Top"/>
					<Grid Grid.Row="1"
					      DockPanel.Dock="Bottom"
					      ColumnDefinitions="1*,1*"
					      Margin="5"
					      VerticalAlignment="Bottom">
						<Button Grid.Column="0"
						        x:Name="btnMoveUp"
						        Classes="Reorder"
						        Content="Move Up"/>
						<Button Grid.Column="1"
						        x:Name="btnMoveDown"
						        Classes="Reorder"
						        Content="Move Down"/>
					</Grid>
					
				</Grid>
			</Border>

			<!-- Bottom Section - Dialog Buttons -->
			<userControls:CheckBoxControl x:Name="ckbxTileView"
										  VerticalAlignment="Bottom"
										  Margin="5"
										  Grid.Row="1"
										  Grid.Column="0"/>
			
			<StackPanel Orientation="Horizontal"
						Grid.Row="1"
						Grid.Column="1"
						Spacing="5"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Right">

				<Button x:Name="btnSettings"
						Classes="Primary"
						Margin="5 0"
						Content="Settings"
						Click="btnSettings_Click"/>

				<Button x:Name="btnCancel"
						Classes="Primary"
						Content="Cancel"
						IsCancel="True"
						Click="btnCancel_Click"/>

				<Button x:Name="btnPlot"
						Classes="Primary"
						Margin="5 0"
						Content="Plot"
						Click="btnPlot_Click"/>

			</StackPanel>

		</Grid>

	</DockPanel>

</Window>
