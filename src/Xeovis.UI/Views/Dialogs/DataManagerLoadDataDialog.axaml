<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
		MinHeight="400"
		MinWidth="500"
		Height="600"
		Width="800"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
		x:DataType="vm:DataManagerLoadDataViewModel"
        x:Class="Xeovis.UI.DataManagerLoadDataDialog"
        Title="Data Manager - Load Data"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterScreen"
		FontFamily="Segoe UI"
		FontSize="14">


	<DockPanel>
		<StackPanel DockPanel.Dock="Top" VerticalAlignment="Top" HorizontalAlignment="Left">
			
		</StackPanel>

		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="15" Margin="15" VerticalAlignment="Bottom" HorizontalAlignment="Right">
			<Button x:Name="btnCancel" Width="70" Height="30" Content="Cancel" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsCancel="True"/>
			<Button x:Name="btnOk" Width="70" Height="30" Content="OK" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsDefault="True"/>
		</StackPanel>
	</DockPanel>
</Window>
