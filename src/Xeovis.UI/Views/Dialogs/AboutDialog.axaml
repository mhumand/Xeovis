<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="500"
        x:Class="Xeovis.UI.AboutDialog"
		Title="Xeovis - About"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		Width="450"
		Height="500"
		WindowStartupLocation="CenterScreen"
		ShowInTaskbar="False"
		CanResize="False"
		FontFamily="Segoe UI"
		FontWeight="SemiBold"
		FontSize="14">

	<Border BorderBrush="Gray" BorderThickness="2" Margin="10" CornerRadius="5">

		<StackPanel Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center">
			<Image Source="/Assets/XeovisLogoLarge.png" Width="128" Height="128" Margin="30"/>

			<StackPanel Orientation="Horizontal" Spacing="5">
				<TextBlock Margin="0 5" FontSize="18" FontWeight="Bold">XEOVIS</TextBlock>

				<TextBlock Margin="0 5" FontStyle="Italic" VerticalAlignment="Center">"zee-oh-vis"</TextBlock>
			</StackPanel>

			<TextBlock Margin="0 5" xml:space="preserve">An x-eos visualizer.</TextBlock>

			<Separator/>

			<TextBlock Margin="0 5" xml:space="preserve" Text="{Binding Description}" TextWrapping="Wrap"/>

		</StackPanel>
		
	</Border>
</Window>
