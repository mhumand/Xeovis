<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
		Height="400"
		Width="600"
		CanResize="False"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels.DialogsViewModels"
		x:DataType="vm:mctcLoadDataViewModel"
        x:Class="Xeovis.UI.mctcLoadDataDialog"
        Title="MCTC - Load Data">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>

		<Style Selector="Border.Custom">
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Padding" Value="10 0"/>
		</Style>
	</Window.Styles>

	<DockPanel Margin="15">
		
		<!-- Top Section - Directory + Scan -->
		<Grid DockPanel.Dock="Top"
			  RowDefinitions="55,10,55"
			  ColumnDefinitions="*,80">
			
			<userControls:LabelInputControl x:Name="licName" Width="150" HorizontalAlignment="Left"/>
			
			<userControls:LabelBrowseDirectoryControl x:Name="lbdcDirectory"
													  Grid.Row="2"
													  Grid.Column="0"
													  VerticalAlignment="Bottom"/>

			<Button x:Name="btnScan"
					Grid.Column="1"
					Grid.Row="2"
					Classes="Primary"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Right"
					Content="Scan"
					Click="btnScan_Click"/>

		</Grid>

		<Grid DockPanel.Dock="Top"
			  Margin="0 15 0 0"
			  RowDefinitions="*,50">

			<Border Classes="Custom" BorderBrush="Gray">
				<userControls:LabelListControl x:Name="llcTxtFiles"/>
			</Border>

			<!-- Bottom Section - Dialog Buttons -->
			<StackPanel Orientation="Horizontal"
						Grid.Row="1"
						Spacing="10"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Right">

				<Button x:Name="btnCancel"
						Classes="Primary"
						Content="Cancel"
						Click="btnCancel_Click"/>

				<Button x:Name="btnLoad"
						Classes="Primary"
						Content="Load"
						Click="btnLoad_Click"/>

			</StackPanel>
		</Grid>
	</DockPanel>
</Window>
