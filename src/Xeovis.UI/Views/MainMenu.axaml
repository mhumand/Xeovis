<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
             x:Class="Xeovis.UI.MainMenu"
			 DataContext="{Binding RelativeSource={RelativeSource Self}}">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		<Style Selector="MenuItem">
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style Selector="MenuItem TextBlock">
			<Setter Property="FontSize" Value="12" />
		</Style>

		<Style Selector="Separator">
			<Setter Property="Height" Value="0.8"/>
			<Setter Property="Background" Value="DarkGray"/>
		</Style>

		<Style Selector="Image">
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<Menu VerticalAlignment="Top" 
		  BorderBrush="LightGray"
		  BorderThickness="0 0 0 0">

		<MenuItem Header="_File">

			<MenuItem x:Name="btnNew"
					  Header="_New"
					  Command="{Binding File_New}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/new.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnOpen"
					  Header="_Open"
					  Command="{Binding File_Open}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/open.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnSave"
					  Header="_Save"
					  Command="{Binding File_Save}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/save.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnSaveAs"
					  Header="_Save As"
					  Command="{Binding File_SaveAs}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/save.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<Separator/>

			<MenuItem x:Name="btnPreferences"
			          IsEnabled="False"
					  Header="_Preferences">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/preferences.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnQuit"
					  Header="_Quit"
					  Command="{Binding File_Quit}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/quit.png"/>
				</MenuItem.Icon>
			</MenuItem>

		</MenuItem>

		<MenuItem Header="_Data Manager">

			<MenuItem x:Name="btnDMLoadData"
					  Header="_Load Data"
				  Command="{Binding DataManager_LoadData}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/import.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnDMExport"
					  Header="_Export"
					  IsEnabled="False"
					  Command="{Binding DataManager_Export}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/export.png"/>
				</MenuItem.Icon>
			</MenuItem>

		</MenuItem>

		<MenuItem Header="_MCTC">

			<MenuItem x:Name="btnMctcLoadBundle"
					  Header="_Load Bundle"
					  Command="{Binding Mctc_LoadBundle}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/bundle.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnMctcNewPlot"
					  Header="_New Plot"
					  Command="{Binding Mctc_NewPlot}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/newplot.png"/>
				</MenuItem.Icon>
			</MenuItem>
			
			<Separator IsVisible="False"/>
			
			<MenuItem x:Name="btnMctcCalibration"
			          Header="_Calibration"
			          IsVisible="False"
			          Command="{Binding Mctc_Calibration}">
				<MenuItem.Icon>
					<Image Source=""/>
				</MenuItem.Icon>
			</MenuItem>

		</MenuItem>

		<MenuItem Header="Settings">
			<MenuItem x:Name="btnSettingsPhaseNames"
					  Header="_Phase Names"
					  Command="{Binding Settings_PhaseNames}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/names.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnSettingsXeosVariables"
					  Header="x-eos Variables"
					  Command="{Binding Settings_XeosVariables}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/variables.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<Separator />

			<MenuItem x:Name="btnSettingsPhaseComponents"
					  Header="Phase Components"
					  Command="{Binding Settings_PhaseComponents}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/components.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="btnSettingsVariableElements"
					  Header="Variable Elements"
					  Command="{Binding Settings_VariableElements}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/elements.png"/>
				</MenuItem.Icon>
			</MenuItem>
		</MenuItem>
			
		<MenuItem Header="_Tools">
			<MenuItem x:Name="btnAPI"
			          Header="_API"
			          ToolTip.Tip="Background API Settings"
			          Command="{Binding Tools_API}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/api.png"/> 
				</MenuItem.Icon>
			</MenuItem>
		</MenuItem>
		
		<MenuItem Header="View">

			<MenuItem x:Name="itemShowLeftPanel"
					  ToggleType="CheckBox"
					  IsChecked="True"
					  Header="Show Left Panel"
					  ToolTip.Tip="Show the experiments and mctc plots tree list panels on the left."
					  Command="{Binding View_ShowLeftPanel}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/leftpanel.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem x:Name="itemOpenLogFolder"
			          Header="Open Log Folder"
			          ToolTip.Tip="Opens the folder containing Xeovis log files."
			          Command="{Binding View_OpenLogFolder}">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/log.png"/>
				</MenuItem.Icon>
			</MenuItem>
			
		</MenuItem>

		<MenuItem Header="_Help">

			<MenuItem Header="_Help"
			          IsEnabled="False">
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/help.png"/>
				</MenuItem.Icon>
			</MenuItem>

			<Separator />

			<MenuItem Header="_About" Command="{Binding About}" >
				<MenuItem.Icon>
					<Image Source="/Assets/MainMenu/about.png"/>
				</MenuItem.Icon>
			</MenuItem>

		</MenuItem>
	</Menu>

</UserControl>
