<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
             x:Class="Xeovis.UI.MainMenu"
			 DataContext="{Binding RelativeSource={RelativeSource Self}}">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		<Style Selector="MenuItem">
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style Selector="Separator">
			<Setter Property="Height" Value="0.8"/>
			<Setter Property="Background" Value="DarkGray"/>
		</Style>
	</UserControl.Styles>

	<Menu VerticalAlignment="Top">

		<MenuItem Header="_Project">
			<MenuItem Header="_New" Command="{Binding Project_New}"/>
			<MenuItem Header="_Open" Command="{Binding Project_Open}"/>
			<MenuItem Header="_Save" Command="{Binding Project_Save}"/>
			<Separator/>
			<MenuItem Header="_Preferences"/>
			<MenuItem Header="_Quit" Command="{Binding Project_Quit}"/>
		</MenuItem>

		<MenuItem Header="_Data Manager">
			<MenuItem Header="_Load Data" Command="{Binding DataManager_LoadData}"/>
			<MenuItem Header="_Export" Command="{Binding DataManager_Export}"/>
			<Separator/>
			<MenuItem Header="_Settings" Command="{Binding DataManager_Settings}"/>
		</MenuItem>
		
		<MenuItem Header="_MCTC">
			<MenuItem Header="_Reload" ToolTip.Tip="Reloads the last mctc bundle from its directory"/>
			<MenuItem Header="_Load Bundle" Command="{Binding MctcPlots_LoadBundle}"/>
			<Separator/>
			<MenuItem Header="_New Plot" Command="{Binding MctcPlots_NewPlot}"/>
		</MenuItem>

		<MenuItem Header="View">
			<MenuItem x:Name="itemShowLeftPanel"
					  ToggleType="CheckBox"
					  IsChecked="True"
					  Header="Show Left Panel"
					  ToolTip.Tip="Show the experiments and mctc plots tree list panels on the left."
					  Command="{Binding View_ShowLeftPanel}"/>
		</MenuItem>

		<MenuItem Header="_Help">
			<MenuItem Header="_Help"/>
			<Separator />
			<MenuItem Header="_About" Command="{Binding About}" />
		</MenuItem>
	</Menu>

</UserControl>
