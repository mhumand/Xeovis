<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="60"
			 MinHeight="60"
			 MinWidth="200"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
             x:Class="Xeovis.UI.LabelInputControl"
			 x:DataType="vm:LabelInputControlViewModel">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
	</UserControl.Styles>

	<Grid RowDefinitions="25, *" >
		<StackPanel Grid.Row="0"
					VerticalAlignment="Top"
					Orientation="Horizontal"
					Spacing="5">

			<TextBlock x:Name="tbLabel"
					   Text="{Binding Label}"/>

			<userControls:ToolTipControl x:Name="toolTip"/>
		</StackPanel>

		<Grid x:Name="txtBtnGrid" Grid.Row="1">
			<TextBox x:Name="tbInput"
					 VerticalAlignment="Top"
					 VerticalContentAlignment="Top"
					 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
					 IsReadOnly="{Binding IsReadOnly}"
					 Focusable="{Binding !IsReadOnly}"
					 AcceptsReturn="{Binding IsMultiLine}"/>

			<Button x:Name="btnClear"
					Classes="InLine"
					VerticalAlignment="Top"
					Margin="0 2 2 0"
					Opacity="0.5"
					Click="btnClear_Click">
				<Button.Content>
					<Image x:Name="image" Width="16" Height="16" Source="/Assets/clear.png"/>
				</Button.Content>
			</Button>
		</Grid>
	</Grid>

</UserControl>
