<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="60"
			 MinWidth="200"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
             x:Class="Xeovis.UI.LabelInputControl"
			 x:DataType="vm:LabelInputControlViewModel">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
	</UserControl.Styles>

	<DockPanel>
		<StackPanel DockPanel.Dock="Top"
		            Margin="0 2"
		            IsVisible="{Binding IsLabelVisible}"
					VerticalAlignment="Top"
					Orientation="Horizontal"
					Spacing="5">

			<TextBlock x:Name="tbLabel"
					   Text="{Binding Label}"/>

			<userControls:ToolTipControl x:Name="toolTip"/>
		</StackPanel>

		<Grid x:Name="txtBtnGrid" DockPanel.Dock="Top">
			<TextBox x:Name="tbInput"
					 VerticalAlignment="Top"
					 VerticalContentAlignment="Top"
					 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
					 IsReadOnly="{Binding IsReadOnly}"
					 Focusable="{Binding !IsReadOnly}"
					 AcceptsReturn="{Binding IsMultiLine}"/>
			
			<StackPanel Margin="8 4 5 2"
			            Spacing="5"
			            Background="White"
				        VerticalAlignment="Top"
				        HorizontalAlignment="Right"
			            Orientation="Horizontal">
				
				<Button x:Name="btnRestore"
				        Classes="InLine"
				        Margin="0 2"
				        Width="16"
				        Height="16"
				        Opacity="0.5"
				        Focusable="False"
				        ToolTip.Tip="Restore Default"
				        Click="btnRestore_Click">
					<Button.Content>
						<Image Width="16" Height="16" Source="/Assets/Chart/ZoomReset.png"/>
					</Button.Content>
				</Button>
				
				<Button x:Name="btnClear"
				        Classes="InLine"
				        Margin="0 2"
				        Width="16"
				        Height="16"
				        Opacity="0.5"
				        ToolTip.Tip="Clear"
				        Click="btnClear_Click">
					<Button.Content>
						<Image Width="16" Height="16" Source="/Assets/clear.png"/>
					</Button.Content>
				</Button>
			</StackPanel>

		</Grid>
	</DockPanel>

</UserControl>
