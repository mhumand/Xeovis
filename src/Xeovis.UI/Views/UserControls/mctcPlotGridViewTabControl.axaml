<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:uc="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 x:DataType="vm:mctcPlotGridViewModel"
             x:Class="Xeovis.UI.mctcPlotGridViewTabControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>

		<Style Selector="Border.Custom">
			<Setter Property="BorderThickness" Value="1.3"/>
			<Setter Property="BorderBrush" Value="#AF6A0B"/>
			<Setter Property="Padding" Value="3" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="DarkGray"/>
			<Setter Property="BorderBrush" Value="White"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Opacity" Value="0.3"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<!-- Top Section - mctc table-->
		<Grid DockPanel.Dock="Top"
			  Margin="0 0 0 5"
			  VerticalAlignment="Top"
			  Height="70"
			  ColumnDefinitions="130, *, 300">

			<uc:LabelSpinnerControl x:Name="spinnerMctcRun"
									MinWidth="100"
									VerticalAlignment="Bottom"
									Grid.Column="0"/>

			<uc:TableControl x:Name="tableMctcRuns"
							 MinWidth="100"
							 MinHeight="50"
							 Margin="5 0"
							 Grid.Column="1"/>

			<Border Classes="Custom"
					Grid.Column="2">

				<Grid ColumnDefinitions="1*,1*">
					<uc:LabelSpinnerControl x:Name="spinnerColumnNo"
											Grid.Column="0"/>

					<StackPanel Grid.Column="1"
								VerticalAlignment="Bottom"
								Margin="5 0">
						<TextBlock Text="Zoom" HorizontalAlignment="Center"/>
						<Slider	x:Name="slider"
								VerticalAlignment="Bottom"
								Height="40"
								Margin="0 -10 0 0"
								IsSnapToTickEnabled="True"
								TickFrequency="25"
								LargeChange="50"
								SmallChange="25"/>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Main Section - Filters + Legend + Plots -->
		<Border Classes="Custom"
				DockPanel.Dock="Top">

			<SplitView x:Name="splitView"
					   IsPaneOpen="True"
					   OpenPaneLength="250"
					   PanePlacement="Left"
					   CompactPaneLength="25"
					   DisplayMode="CompactInline">

				<!--Side Panel-->
				<SplitView.Pane>
					<Grid RowDefinitions="30,*">

						<!--Buttons-->
						<StackPanel Grid.Row="0"
									Orientation="Horizontal"
									HorizontalAlignment="Right">

							<Button x:Name="btnExport"
									Click="btnExport_Click"
									Background="Transparent"
									IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
									ToolTip.Tip="Export All Data"
									Classes="InLine">
								<Button.Content>
									<Image Width="16" Height="16" Source="/Assets/MainMenu/export.png"/>
								</Button.Content>
							</Button>
							
							<Button x:Name="btnSettings"
									Click="btnSettings_Click"
									Background="Transparent"
									IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
									ToolTip.Tip="Settings"
									Classes="InLine">
								<Button.Content>
									<Image Width="16" Height="16" Source="/Assets/settings.png"/>
								</Button.Content>
							</Button>

							<Button
								x:Name="btnSidePanel"
								Click="btnSidePanel_Click"
								ToolTip.Tip="Show/Hide Filter Panel"
								Background="Transparent"
								Classes="InLine">
								<Button.Content>
									<Image Width="16" Height="16" Source="/Assets/filter.png"/>
								</Button.Content>
							</Button>
						</StackPanel>

						<Button x:Name="btnClearFilters"
								Classes="Primary"
								Grid.Row="0"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Width="90"
								Margin="3"
								Height="25"
								IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
								Click="btnClearFilters_Click"
								Content="Clear Filters"/>

						<Grid Grid.Row="1"
							  IsVisible="{Binding IsPaneOpen, ElementName=splitView}">
							<Grid.RowDefinitions>
								<RowDefinition Height="1*" MinHeight="150"/>
								<RowDefinition Height="10"/>
								<RowDefinition Height="1*" MinHeight="150"/>
							</Grid.RowDefinitions>

							<!--Phase Filters-->
							<Border Grid.Row="0"
									Classes="Custom"
									BorderBrush="Gray"
									Margin="1">
								<Grid RowDefinitions="25,*">
									<TextBlock Grid.Row="0"
											   Margin="3 0"
											   FontWeight="SemiBold"
											   Text="Phase Filters" />

									<uc:TableControl x:Name="tableFilter"
													 Grid.Row="1"
													 MinWidth="100"
													 MinHeight="70"/>

								</Grid>
							</Border>

							<GridSplitter Grid.Row="1"
										  ResizeDirection="Rows"/>

							<!--Global Legend-->
							<Border Grid.Row="2"
									Classes="Custom"
									BorderBrush="Gray"
									Margin="1">
								<Grid RowDefinitions="25,*">
									<TextBlock Grid.Row="0"
											   Margin="3 0"
											   FontWeight="SemiBold"
											   Text="Global Legend" />
									<ScrollViewer Grid.Row="1">
										<StackPanel x:Name="stackLegend"/>
									</ScrollViewer>
								</Grid>
							</Border>
						</Grid>

					</Grid>

				</SplitView.Pane>


				<!--Charts-->
				<ScrollViewer>
					<UniformGrid x:Name="uniformGrid"
								 Height="{Binding Height, ElementName=splitView}"/>
				</ScrollViewer>

			</SplitView>

		</Border>

	</DockPanel>
</UserControl>
