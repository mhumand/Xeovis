<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="55"
			 MinHeight="55"
			 MinWidth="200"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 x:DataType="vm:LabelBrowseDirectoryControlViewModel"
             x:Class="Xeovis.UI.LabelBrowseDirectoryControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/Textboxes.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
	</UserControl.Styles>
	
	<Grid RowDefinitions="23,32">
		<StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
			<TextBlock x:Name="tbLabel"
					   Text="{Binding Label}"/>
			
			<userControls:ToolTipControl x:Name="toolTip"/>
		</StackPanel>

		<Grid Grid.Row="1" x:Name="txtBtnGrid">
			<TextBox x:Name="tbInput"
					 Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}"/>
			
			<StackPanel Margin="5 4 5 2"
			            Spacing="5"
			            Background="White"
			            VerticalAlignment="Top"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal">
				
				<Button x:Name="btnRestore"
				        Classes="InLine"
				        Margin="0 2"
				        Width="16"
				        Height="16"
				        Opacity="0.5"
				        Focusable="False"
				        ToolTip.Tip="Restore Default"
				        Click="btnRestore_Click">
					<Button.Content>
						<Image Width="16" Height="16" Source="/Assets/Chart/ZoomReset.png"/>
					</Button.Content>
				</Button>
				
				<Button x:Name="btnBrowse"
				        Classes="InLine"
				        Margin="0"
				        Click="btnBrowse_Click"
				        ToolTip.Tip="Browse">
					<Button.Content>
						<Image x:Name="image" Width="16" Height="16" Source="/Assets/browse.png"/>
					</Button.Content>
				</Button>
			</StackPanel>

		</Grid>
	</Grid>
</UserControl>
