<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="60"
			 MinHeight="60"
			 MinWidth="400"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 x:DataType="vm:LabelBrowseDirectoryControlViewModel"
             x:Class="Xeovis.UI.LabelBrowseDirectoryControl">

	<StackPanel Margin="2" Spacing="5">
		<StackPanel Orientation="Horizontal" Spacing="5">
			<TextBlock x:Name="tbLabel" Text="{Binding Label}" FontWeight="Regular"/>
			<userControls:ToolTipControl x:Name="toolTip"/>
		</StackPanel>

		<Grid x:Name="txtBtnGrid">
			<TextBox x:Name="tbInput" BorderThickness="0.6"  BorderBrush="DarkGray"
					 Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}"
					 SelectionBrush="SkyBlue" VerticalContentAlignment="Center"/>
			<Button x:Name="btnBrowse" Margin="1,1,5,1" Padding="0" Width="25" Height="25" Background="White" Foreground="Transparent"
					HorizontalAlignment="Right" VerticalAlignment="Center"
					 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
					Click="btnBrowse_Click" ToolTip.Tip="Browse">
				<Button.Content>
					<Image x:Name="image" Width="16" Height="16" Source="/Assets/browse.png"/>
				</Button.Content>
			</Button>
		</Grid>
	</StackPanel>
</UserControl>
