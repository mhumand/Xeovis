<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="60"
			 MinHeight="30"
			 MinWidth="200"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 x:DataType="vm:CheckBoxControlViewModel"
             x:Class="Xeovis.UI.CheckBoxControl"
			 FontFamily="Segoe UI"
			 FontSize="14">

	<StackPanel VerticalAlignment="Top" Margin="10,0,10,0">
		<CheckBox x:Name="checkBox" Content="{Binding Label}" FontWeight="SemiBold" IsChecked="{Binding IsChecked}" Checked="checkBox_CheckChanged" Unchecked="checkBox_CheckChanged" />
		<TextBlock  Margin="28,0,0,0" Text="{Binding Description}" Foreground="Gray" IsVisible="{Binding HasDescription}"/>
	</StackPanel>

</UserControl>
