<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="35"
			 MinHeight="35"
			 MinWidth="100"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 x:DataType="vm:CheckBoxControlViewModel"
             x:Class="Xeovis.UI.CheckBoxControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
	</UserControl.Styles>
	
	<StackPanel VerticalAlignment="Top"
				Orientation="Horizontal"
				Margin="0"
				Spacing="5">
		<CheckBox x:Name="checkBox"
				  Content="{Binding Label}"
				  IsChecked="{Binding IsChecked}"
				  Checked="checkBox_CheckChanged"
				  Unchecked="checkBox_CheckChanged"/>
		<userControls:ToolTipControl x:Name="toolTip"/>
	</StackPanel>

</UserControl>
