<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
			 MinHeight="200"
			 MinWidth="200"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 x:DataType="vm:ChartControlViewModel"
			 xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="Xeovis.UI.ChartControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>

		<Style Selector="Image">
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="16" />
		</Style>
		
		<Style Selector="Button.ToolBar">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="1"/>
		</Style>

		<Style Selector="ToggleButton.ToolBar">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="1"/>
		</Style>

		<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#400067A5"/>
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="BorderBrush" Value="#0067A5"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</UserControl.Styles>

	<Border x:Name="container" BorderBrush="LightGray" BorderThickness="1">
		<Grid ColumnDefinitions="*,25">
			<ScottPlot:AvaPlot x:Name="scottPlot" Grid.Column="0"/>

			<Border Padding="0 10"
					CornerRadius="1"
					Background="#f5f5f5"
					Grid.Column="1">

				<StackPanel x:Name="toolBar"
							Orientation="Vertical"
							Background="#f5f5f5"
							Spacing="5">

					<Button x:Name="btnChartData"
					        Classes="ToolBar">
						<Button.Content>
							<Image Source="/Assets/Chart/Table.png"/>
						</Button.Content>
					</Button>
					
					<Button x:Name="btnResetZoom"
							Classes="ToolBar"
							ToolTip.Tip="Reset Zoom">
						<Button.Content>
							<Image Source="/Assets/Chart/ZoomReset.png"/>
						</Button.Content>
					</Button>

					<Button x:Name="btnZoomIn"
							Classes="ToolBar"
							ToolTip.Tip="Zoom In">
						<Button.Content>
							<Image Source="/Assets/Chart/ZoomIn.png" />
						</Button.Content>
					</Button>

					<Button x:Name="btnZoomOut"
							Classes="ToolBar"
							ToolTip.Tip="Zoom Out">
						<Button.Content>
							<Image Source="/Assets/Chart/ZoomOut.png" />
						</Button.Content>
					</Button>

					<ToggleButton x:Name="btnRectangleZoom"
							Classes="ToolBar"
							ToolTip.Tip="Rectangle Zoom">
						<Button.Content>
							<Image Source="/Assets/Chart/ZoomRectangle.png" />
						</Button.Content>
					</ToggleButton>

					<ToggleButton x:Name="btnLegend"
								  Classes="ToolBar"
								  ToolTip.Tip="Show/Hide Legend">
						<ToggleButton.Content>
							<Image Source="/Assets/Chart/Legend.png"/>
						</ToggleButton.Content>
					</ToggleButton>
				</StackPanel>
			</Border>
		</Grid>
	</Border>

</UserControl>
