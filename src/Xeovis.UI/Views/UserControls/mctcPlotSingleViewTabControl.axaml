<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:uc="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 x:DataType="vm:mctcPlotSingleViewModel"
             x:Class="Xeovis.UI.mctcPlotSingleViewTabControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/TabItems.axaml"/>

		<Style Selector="Border.Custom">
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="BorderBrush" Value="#AF6A0B"/>
			<Setter Property="Padding" Value="2" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="DarkGray"/>
			<Setter Property="BorderBrush" Value="White"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Opacity" Value="0.3"/>
		</Style>
		
		<Style Selector="Label.Title">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="BorderBrush" Value="DarkGray" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="FontWeight" Value="ExtraBold"></Setter>
		</Style>

		<Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#400067A5"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		
		<Style Selector="TabItem">
			<Setter Property="MinHeight"  Value="30"/>
			<Setter Property="Padding"  Value="8 0"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<!-- Top Section - xoesVar combobox + mctc Slider-->
		<Grid DockPanel.Dock="Top"
			  Margin="0 0 0 5"
			  VerticalAlignment="Top"
			  Height="100"
			  ColumnDefinitions="400, *">
			
			<Border Grid.Column="0"
			        Classes="Custom">
				<Grid ColumnDefinitions="*,25,*"
				      Margin="5 0">
					
					<StackPanel Grid.Column="0"
					            Spacing="2"
					            Background="WhiteSmoke"
					            VerticalAlignment="Bottom">
						<Label Content="Y-Axis" Classes="Title"/>
						<uc:LabelComboBoxControl x:Name="lcbcYAxisType"
						                         MinWidth="50"
						                         Width="170"
						                         HorizontalAlignment="Stretch"/>
				
						<uc:LabelComboBoxControl x:Name="lcbcYAxisVariable"
						                         MinWidth="50"
						                         Width="170"
						                         HorizontalAlignment="Stretch"/>
					</StackPanel>

					<ToggleButton Grid.Column="1"
								  x:Name="toggleLink"
								  Margin="0 0 0 5"
								  Height="20"
								  Width="20"
								  IsChecked="true"
								  Background="Transparent"
								  ToolTip.Tip="Link Axes Variables"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Bottom">
						<ToggleButton.Content>
							<Image Width="16" Height="16" Source="/Assets/link.png"/>
						</ToggleButton.Content>
					</ToggleButton>
					
					<StackPanel Grid.Column="2"
					            Spacing="2"
					            Background="WhiteSmoke"
					            VerticalAlignment="Bottom">
						<Label Content="X-Axis" Classes="Title"/>
						<uc:LabelComboBoxControl x:Name="lcbcXAxisType"
						                         MinWidth="50"
						                         Width="170"
						                         HorizontalAlignment="Stretch"/>
				
						<uc:LabelComboBoxControl x:Name="lcbcXAxisVariable"
						                         MinWidth="50"
						                         Width="170"
						                         HorizontalAlignment="Stretch"/>
					</StackPanel>
				</Grid>
			</Border>
			
			<Border Grid.Column="1"
			        Classes="Custom"
			        Margin="5 0 0 0">
				<Grid ColumnDefinitions="130,*">
					<uc:LabelSpinnerControl x:Name="spinner"
					                        Margin="2 0"
					                        VerticalAlignment="Bottom"
					                        Grid.Column="0"/>

					<uc:TableControl x:Name="tableMctcRuns"
					                 MinHeight="50"
					                 Margin="5 0 0 0"
					                 Grid.Column="1"/>
				</Grid>
			</Border>

		</Grid>

		<!-- Main Section - Batches + Plot + Table-->
		<Border Classes="Custom"
				DockPanel.Dock="Top">

			<SplitView x:Name="splitView"
					   IsPaneOpen="True"
					   OpenPaneLength="250"
					   PanePlacement="Left"
					   CompactPaneLength="25"
					   DisplayMode="CompactInline">

				<!--Left Panel-->
				<SplitView.Pane>
					<Grid RowDefinitions="30, *">

						<!--Buttons-->
						<StackPanel Grid.Row="0"
									Orientation="Horizontal"
									HorizontalAlignment="Right">

							<Button x:Name="btnSettings"
									Click="btnSettings_Click"
									Background="Transparent"
									IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
									ToolTip.Tip="Settings"
									Classes="InLine">
								<Button.Content>
									<Image Width="16" Height="16" Source="/Assets/settings.png"/>
								</Button.Content>
							</Button>

							<Button
								x:Name="btnSidePanel"
								Click="btnSidePanel_Click"
								ToolTip.Tip="Show/Hide Filter Panel"
								Background="Transparent"
								Classes="InLine">
								<Button.Content>
									<Image Width="16" Height="16" Source="/Assets/filter.png"/>
								</Button.Content>
							</Button>
						</StackPanel>

						<Button x:Name="btnClearFilters"
								Classes="Primary"
								Grid.Row="0"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Width="90"
								Height="25"
								Margin="3"
								IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
								Click="btnClearFilters_Click"
								Content="Clear Filters"/>
						
						<Border Grid.Row="1"
						        Classes="Custom"
						        BorderBrush="Gray"
						        Margin="1"
						        Padding="0 0 0 5"
						        IsVisible="{Binding IsPaneOpen, ElementName=splitView}">
							<TabControl IsVisible="{Binding IsPaneOpen, ElementName=splitView}">
								<TabItem  Header="Global Legend">
									<ScrollViewer HorizontalScrollBarVisibility="Auto">
										<StackPanel x:Name="stackLegend"/>
									</ScrollViewer>
								</TabItem>
								
								<TabItem Header="Phase Filter">
									<uc:TableControl x:Name="tableFilter"
									                 MinWidth="100"/>
								</TabItem>
							</TabControl>
						</Border>
						
					</Grid>
				</SplitView.Pane>

				<!--Chart and Table-->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*" MinWidth="200"/>
						<ColumnDefinition Width="1*" MinWidth="200"/>
					</Grid.ColumnDefinitions>

					<uc:ChartControl x:Name="chartControl"
									 Margin="3 0"
									 Grid.Column="0"/>

					<uc:TableControl x:Name="tableControl"
									 Margin="3 0 0 0"
									 Grid.Column="1"/>
				</Grid>

			</SplitView>

		</Border>

	</DockPanel>

</UserControl>
