<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:uc="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 x:DataType="vm:mctcPlotSingleViewModel"
             x:Class="Xeovis.UI.mctcPlotSingleViewTabControl">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>

		<Style Selector="Border.Custom">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="#AF6A0B"/>
			<Setter Property="Padding" Value="5 5" />
			<Setter Property="Margin" Value="3" />
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="DarkGray"/>
			<Setter Property="BorderBrush" Value="White"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Opacity" Value="0.3"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<!-- Top Section - xoesVar combobox + mctc Slider-->
		<Grid DockPanel.Dock="Top"
			  Margin="5 5"
			  VerticalAlignment="Top"
			  Height="70"
			  ColumnDefinitions="150, 150, *">
			<uc:LabelComboBoxControl x:Name="lcbcXeosVariable"
									 Grid.Column="0"
									 Margin="10 0"
									 MinWidth="100"
									 VerticalAlignment="Bottom"
									 HorizontalAlignment="Stretch"/>

			<uc:LabelSpinnerControl x:Name="spinner"
									Margin="5 0"
									VerticalAlignment="Bottom"
									Grid.Column="1"/>

			<uc:TableControl x:Name="tableMctcRuns"
							 MinHeight="50"
							 Grid.Column="2"/>
		</Grid>

		<!-- Main Section - Batches + Plot + Table-->
		<Border Classes="Custom"
				DockPanel.Dock="Top">

			<SplitView x:Name="splitView"
					   IsPaneOpen="True"
					   OpenPaneLength="250"
					   PanePlacement="Left"
					   CompactPaneLength="30"
					   DisplayMode="CompactInline">

				<!--Left Panel-->
				<SplitView.Pane>
					<Grid RowDefinitions="30, *">

						<!--Buttons-->
						<Button Grid.Row="0"
								x:Name="btnSidePanel"
								Click="btnSidePanel_Click"
								Margin="3 3"
								Background="Transparent"
								ToolTip.Tip="Show/Hide Filter Panel"
								Classes="InLine">
							<Button.Content>
								<Image Width="16" Height="16" Source="/Assets/filter.png"/>
							</Button.Content>
						</Button>

						<Button x:Name="btnClearFilters"
								Classes="Primary"
								Grid.Row="0"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Width="100"
								Margin="5"
								IsVisible="{Binding IsPaneOpen, ElementName=splitView}"
								Click="btnClearFilters_Click"
								Content="Clear Filters"/>


						<Grid Grid.Row="1"
							  IsVisible="{Binding IsPaneOpen, ElementName=splitView}">
							<Grid.RowDefinitions>
								<RowDefinition Height="1*" MinHeight="150"/>
								<RowDefinition Height="10"/>
								<RowDefinition Height="1*" MinHeight="150"/>
							</Grid.RowDefinitions>

							<!--Phase Filters-->
							<Border Grid.Row="0"
									Classes="Custom"
									Margin="3">
								<Grid RowDefinitions="25,*">
									<TextBlock Grid.Row="0"
											   Margin="5 3 5 0"
											   FontWeight="SemiBold"
											   Text="Phase Filters" />

									<uc:TableControl x:Name="tableFilter"
													 Grid.Row="1"
													 MinWidth="100"
													 MinHeight="70"/>
								</Grid>
							</Border>

							<GridSplitter Grid.Row="1"
										  ResizeDirection="Rows"/>

							<!--Chart Legend-->
							<Border Grid.Row="2"
									Classes="Custom"
									Margin="3">
								<Grid RowDefinitions="25,*">
									<TextBlock Grid.Row="0"
											   Margin="5 3 5 0"
											   FontWeight="SemiBold"
											   Text="Chart Legend" />
									<ScrollViewer Grid.Row="1">
										<StackPanel x:Name="stackLegend"
													Margin="5 0"/>
									</ScrollViewer>
								</Grid>
							</Border>
						</Grid>
					</Grid>

				</SplitView.Pane>

				<!--Chart and Table-->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*" MinWidth="200"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="1*" MinWidth="200"/>
					</Grid.ColumnDefinitions>

					<uc:ChartControl x:Name="chartControl"
									 Margin="5 0"
									 Grid.Column="0"/>

					<GridSplitter Grid.Column="1"
								  ResizeDirection="Columns"/>

					<uc:TableControl x:Name="tableControl"
									 Margin="5 0"
									 Grid.Column="2"/>

				</Grid>

			</SplitView>

		</Border>

	</DockPanel>

</UserControl>
