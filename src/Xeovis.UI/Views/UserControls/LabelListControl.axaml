<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
			 MinWidth="100"
			 MinHeight="100"
			 x:Class="Xeovis.UI.LabelListControl"
			 x:DataType="vm:LabelListControlViewModel"
			 FontFamily="Segoe UI"
			 FontSize="14">

	<StackPanel Margin="2" Spacing="5">

		<TextBlock x:Name="tbLabel" Text="{Binding Label}" FontWeight="Regular"/>

		<ListBox x:Name="lbItems" CornerRadius="2" ItemsSource="{Binding Items}" SelectionMode="AlwaysSelected">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid>
						<TextBlock Text="{Binding Label}" Foreground="{Binding Color}" VerticalAlignment="Center"/>

						<Button x:Name="btnRemoveItem" Padding="0" Width="20" Height="20" FontWeight="SemiBold"  Background="Transparent" Opacity="0.75"
						HorizontalAlignment="Right" VerticalAlignment="Center"
						 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
						Tag="{Binding Tag}" Click="btnRemoveItem_Click" IsVisible="{Binding CanBeRemoved}">
							<Button.Content>
								<Image x:Name="image" Width="16" Height="16" Source="/Assets/remove.png"/>
							</Button.Content>
						</Button>

					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</StackPanel>

</UserControl>
