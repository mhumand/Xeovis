<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
			 xmlns:converters="clr-namespace:Xeovis.UI.Views.Helpers.Converters;assembly=Xeovis.UI"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
			 MinWidth="100"
			 MinHeight="100"
			 x:Class="Xeovis.UI.LabelListControl"
			 x:DataType="vm:LabelListControlViewModel"
			 x:Name="control">

	<UserControl.Resources>
		<converters:ColorConverter x:Key="colorConverter" />
		<converters:SelectionModeConverter x:Key="selectionModeConverter" />
	</UserControl.Resources>
	
	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/Buttons.axaml"/>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>

		<Style Selector="ListBoxItem">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="10,0" />
		</Style>
		
	</UserControl.Styles>
	
	<Grid Margin="2" VerticalAlignment="Top">
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
			<TextBlock x:Name="tbLabel"
					   VerticalAlignment="Center"
					   Text="{Binding Label}"/>
			<userControls:ToolTipControl x:Name="toolTip" VerticalAlignment="Center"/>
		</StackPanel>

		<ListBox Grid.Row="1" x:Name="lbItems"
				 IsEnabled="{Binding !IsReadOnly}"
				 ItemsSource="{Binding Items}"
				 SelectionMode="{Binding SelectionMode, Converter={StaticResource selectionModeConverter}}"
				 SelectedIndex="{Binding SelectedIndex}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid VerticalAlignment="Center">
						<TextBlock Text="{Binding Label}"
								   Foreground="{Binding Color,Converter={StaticResource colorConverter}}"
								   VerticalAlignment="Center"/>

						<StackPanel HorizontalAlignment="Right"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Spacing="5">
							
							<TextBlock VerticalAlignment="Center"
									   Text="{Binding Description}"
									   Foreground="{Binding DescriptionColor,Converter={StaticResource colorConverter}}"
									   FontWeight="Light"
									   IsVisible="{Binding HasDescription}"/>

							<CheckBox x:Name="checkBox"
									  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
									  IsVisible="{Binding #control.((vm:LabelListControlViewModel)DataContext).IsCheckable}"
									  Tag="{Binding Tag}"/>

							<Button x:Name="btnRemoveItem"
									Classes="InLine"
									Background="Transparent"
									Opacity="0.75"
									Tag="{Binding Tag}"
									ToolTip.Tip="Remove"
									Click="btnRemoveItem_Click"
									IsVisible="{Binding #control.((vm:LabelListControlViewModel)DataContext).IsRemovable}">
								<Button.Content>
									<Image x:Name="image" Width="16" Height="16" Source="/Assets/remove.png"/>
								</Button.Content>
							</Button>
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</Grid>

</UserControl>
