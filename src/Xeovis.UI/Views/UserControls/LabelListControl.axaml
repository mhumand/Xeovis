<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
			 MinWidth="100"
			 MinHeight="100"
			 x:Class="Xeovis.UI.LabelListControl"
			 x:DataType="vm:LabelListControlViewModel"
			 FontFamily="Segoe UI"
			 FontSize="14">

	<!--I'm using Grid instead of StackPanel becuase the vertical scrollbar in ListBox
	does not appear automatically when using a StackPanel - M.H. 02/04/2025-->
	<Grid Margin="2" VerticalAlignment="Top">
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
			<TextBlock x:Name="tbLabel" VerticalAlignment="Center" Text="{Binding Label}" FontWeight="Regular"/>
			<userControls:ToolTipControl x:Name="toolTip" VerticalAlignment="Center"/>
		</StackPanel>

		<ListBox Grid.Row="1" x:Name="lbItems" ItemsSource="{Binding Items}" SelectionMode="AlwaysSelected" SelectedIndex="{Binding SelectedIndex}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid>
						<TextBlock Text="{Binding Label}" Foreground="{Binding Color}" VerticalAlignment="Center"/>
						<!--todo: add description before button - M.H. 02/04/2025-->
						<Button x:Name="btnRemoveItem" Padding="0" Width="20" Height="20" FontWeight="SemiBold"  Background="Transparent" Opacity="0.75"
						HorizontalAlignment="Right" VerticalAlignment="Center"
						 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
						Tag="{Binding Tag}" Click="btnRemoveItem_Click" IsVisible="{Binding CanBeRemoved}">
							<Button.Content>
								<Image x:Name="image" Width="16" Height="16" Source="/Assets/remove.png"/>
							</Button.Content>
						</Button>
						
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</Grid>

</UserControl>
