<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="56"
			 xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
             xmlns:converters="clr-namespace:Xeovis.UI.Views.Helpers.Converters;assembly=Xeovis.UI"
			 xmlns:locals="clr-namespace:Xeovis.UI.Views.Helpers.Converters;assembly=Xeovis.UI"
			 MinWidth="200"
			 xmlns:vm="using:Xeovis.UI.ViewModels"
             x:Class="Xeovis.UI.LabelComboBoxControl"
			 x:DataType="vm:LabelComboBoxControlViewModel">

	<UserControl.Resources>
		<locals:BoolToOrientationConverter x:Key="OrientationConverter" />
		<converters:ColorConverter x:Key="ColorConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<StyleInclude Source="/Views/Styles/UserControls.axaml"/>
		
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="8,2,0,2" /> 
		</Style>

		<Style Selector="ComboBoxItem">
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="Padding" Value="8,2" />
		</Style>
	</UserControl.Styles>
	
	<StackPanel Spacing="5"
				HorizontalAlignment="Stretch"
				Orientation="{Binding IsStackedHorizontally, Converter={StaticResource OrientationConverter}}">
		<StackPanel IsVisible="{Binding IsLabelVisible}"
					Orientation="Horizontal"
					Spacing="5">
			<TextBlock x:Name="tbLabel"
					   Text="{Binding Label}"/>
			<userControls:ToolTipControl x:Name="toolTip"/>
		</StackPanel>

		<ComboBox x:Name="comboBox"
				  SelectedItem="{Binding SelectedItem}"
				  ItemsSource="{Binding Items}"
				  HorizontalAlignment="Stretch"
				  IsEnabled="{Binding !IsReadOnly}"
				  SelectionChanged="comboBox_SelectionChanged"
				  MinHeight="24"
				  Height="24"
				  MaxDropDownHeight="300">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<Grid VerticalAlignment="Center">
						<TextBlock x:Name="txtLabel"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Left"
								   Text="{Binding Label}" />
						<TextBlock x:Name="txtDescription"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   FontWeight="Light"
								   Text="{Binding Description}"
								   Foreground="{Binding DescriptionColor,Converter={StaticResource ColorConverter}}"
								   IsVisible="{Binding HasDescription}"/>
					</Grid>
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

	</StackPanel>
</UserControl>
