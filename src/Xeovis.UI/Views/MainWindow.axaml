<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
		MinHeight="500"
		MinWidth="700"
        x:Class="Xeovis.UI.Views.MainWindow"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels"
		xmlns:vmModels="using:Xeovis.UI.Models"
		xmlns:converters="clr-namespace:Xeovis.UI.Views.Helpers.Converters"
		x:DataType="vm:MainWindowViewModel"
        Title="Xeovis"
		ShowInTaskbar="True"
		WindowState="Maximized">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/TabItems.axaml"/>
		<StyleInclude Source="/Views/Styles/TreeViews.axaml"/>

		<Style Selector="TextBlock.Primary">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TreeViewItem"  x:DataType="vmModels:TreeNode">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="2"/>
		</Style>

		<Style Selector="Border.Panels">
			<Setter Property="BorderBrush" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="2"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style Selector="Button.Tabs">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="StackPanel.Tabs">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Spacing" Value="5"/>
		</Style>

		<Style Selector="Image.Icon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
			<Setter Property="Background" Value="#AF6A0B"/>
			<Setter Property="Height" Value="3"/>
		</Style>
		
		<!-- <Style Selector="TabItem:selected"> -->
		<!-- 	<Setter Property="Foreground" Value="Black" /> -->
		<!-- 	<Setter Property="Background" Value="WhiteSmoke" /> -->
		<!-- </Style> -->
		
		<Style Selector="Ellipse.BlinkingDot">
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1.0"/>
					</KeyFrame>
					<KeyFrame Cue="50%">
						<Setter Property="Opacity" Value="0.1"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1.0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<Window.Resources>
		<converters:BoolToForegroundConverter x:Key="BoolToColor" />
		<converters:ColorConverter x:Key="ColorConverter" />
	</Window.Resources>
	
	<DockPanel>
		<!-- Main Menu -->
		<Grid x:Name="MenuGrid"
			  DockPanel.Dock="Top"
			  RowDefinitions="*"
			  ColumnDefinitions="*,*">
			<userControls:MainMenu Grid.Column="0" x:Name="mainMenu" />
			
			<StackPanel Grid.Column="1"
			            x:Name="stpApiDot"
			            IsVisible="False"
			            Orientation="Horizontal"
			            HorizontalAlignment="Right"
			            Margin="0,0,10,0">
                
				<TextBlock Text="API Status:"
				           x:Name="txtApiDot"
				           VerticalAlignment="Center"
				           FontSize="14"
				           Foreground="Black"
				           Margin="0,0,5,0"/>
                
				<Ellipse Classes="BlinkingDot"
				         Width="10" 
				         Height="10" 
				         Fill="LimeGreen" 
				         VerticalAlignment="Center"/>
                         
			</StackPanel>
		</Grid>

		<Grid DockPanel.Dock="Top" x:Name="mainGrid" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250" MinWidth="100" MaxWidth="450" />
				<ColumnDefinition Width="5" MinWidth="5" />
				<ColumnDefinition Width="*" MinWidth="500" />
			</Grid.ColumnDefinitions>

			<!-- Tree Lists -->
			<Border Grid.Column="0" Classes="Panels" x:Name="borderTreeLists">
				<Grid x:Name="TreeGrid">
					<Grid.RowDefinitions>
						<RowDefinition Height="1*" MinHeight="200"/>
						<RowDefinition Height="5" MinHeight="5"/>
						<RowDefinition Height="1*" MinHeight="200"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="5 2" RowDefinitions="25,*">
						<StackPanel Grid.Row="0" Classes="Tabs">
							<Image Classes="Icon" Source="/Assets/MainMenu/experiment.png"/>
							<TextBlock Classes="Primary" Text="Experiments" />
						</StackPanel>

						<TreeView x:Name="tvExperiments"
								  Grid.Row="1"
								  ItemsSource="{Binding ExperimentNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<Grid>
										<TextBlock Text="{Binding Label}"/>
										<TextBlock Text="{Binding Description}"
										           Foreground="{Binding DescriptionColor,Converter={StaticResource ColorConverter}}"
										           FontWeight="Light"
										           FontSize="12"
										           IsVisible="{Binding HasDescription}"
										           Margin="2 0 10 0"
										           HorizontalAlignment="Right"/>
									</Grid>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>

					<GridSplitter Grid.Row="1"
								  ResizeDirection="Rows"/>

					<Grid Grid.Row="2" Margin="5 2" RowDefinitions="25,*">
						<StackPanel Grid.Row="0" Classes="Tabs">
							<Image Classes="Icon" Source="/Assets/MainMenu/bundle.png"/>
							<TextBlock Classes="Primary" Text="MCTC Bundles" />
						</StackPanel>
						<TreeView x:Name="tvMctcBundles"
								  Grid.Row="1"
								  ItemsSource="{Binding MctcBundleNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<Border BorderThickness="1.5"
											Padding="4 2"
											Margin="0 3"
											CornerRadius="3"
											HorizontalAlignment="Left"
											BorderBrush="{Binding BorderColor}">
										<TextBlock Text="{Binding Label}"
										           Foreground="{Binding HasVisiblePlot, Converter={StaticResource BoolToColor}}"/>
									</Border>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>

				</Grid>
			</Border>

			<GridSplitter Grid.Column="1"
						  x:Name="splitterVertical"
						  ResizeDirection="Columns"/>

			<!-- Main Pane -->
			<Border Grid.Column="2" Padding="0 2" Classes="Panels" >
				<TabControl x:Name="tabControl"
				            Focusable="True"
							ItemsSource="{Binding TabControls}">

					<TabControl.ItemTemplate>
						<DataTemplate>
							<Border IsVisible="{Binding IsVisible}"
									BorderThickness="1.5"
									Padding="4 0"
									Margin="0 0 0 6"
									CornerRadius="3"
									Height="25"
									BorderBrush="{Binding TabColor}">
								<StackPanel Classes="Tabs" VerticalAlignment="Center">
									<TextBlock Text="{Binding Header}"
											   Tag="{Binding}"
											   VerticalAlignment="Center"/>
									<Button x:Name="btnCloseTab"
											Classes="Tabs"
											Tag="{Binding Id}"
											Click="btnCloseTab_Click"
											IsVisible="{Binding CanBeRemoved}">
										<Button.Content>
											<Image Width="10" Height="10"
												   Source="/Assets/close.png"/>
										</Button.Content>
									</Button>
								</StackPanel>
							</Border>
						</DataTemplate>
					</TabControl.ItemTemplate>

					<TabControl.ContentTemplate>
						<DataTemplate DataType="vm:TabControlViewModelBase">
							<Border BorderBrush="DarkGray"
							        BorderThickness="0 2 0 0"
							        Padding="0 4 0 0"
							        Margin="0">
								<UserControl Content="{Binding OwnerTabControl}"
								             IsVisible="{Binding IsVisible}"/>
							</Border>
						</DataTemplate>
					</TabControl.ContentTemplate>

				</TabControl>
			</Border>
		</Grid>
	</DockPanel>

</Window>
