<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Xeovis.UI.Views.MainWindow"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        Title="Xeovis"
		ShowInTaskbar="True"
		WindowState="Maximized">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"></StyleInclude>

		<Style Selector="TreeView">
			<Setter Property="Margin" Value="0 5"/>
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="5"/>
		</Style>

		<Style Selector="Border.Panels">
			<Setter Property="BorderBrush" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<!-- Main Menu -->
		<Grid x:Name="MenuGrid"
			  DockPanel.Dock="Top"
			  RowDefinitions="*">
			<userControls:MainMenu x:Name="mainMenu" />
		</Grid>

		<Grid DockPanel.Dock="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250" MinWidth="250" />
				<ColumnDefinition Width="5" MinWidth="5" />
				<ColumnDefinition Width="*" MinWidth="500" />
			</Grid.ColumnDefinitions>

			<!-- Tree Views -->
			<Border Grid.Column="0" Classes="Panels">
				<Grid x:Name="TreeGrid">
					<Grid.RowDefinitions>
						<RowDefinition Height="1*" MinHeight="200"/>
						<RowDefinition Height="5" MinHeight="5"/>
						<RowDefinition Height="1*" MinHeight="200"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="10 5" RowDefinitions="25,*">
						<TextBlock Grid.Row="0" Text="Experiments" />
						<TreeView x:Name="tvDataManager"
								  Grid.Row="1"
								  ItemsSource="{Binding ExperimentNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<TextBlock Text="{Binding Label}"/>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>


					<GridSplitter Grid.Row="1"
								  ResizeDirection="Rows"/>

					<Grid Grid.Row="2" Margin="10 5" RowDefinitions="25,*">
						<TextBlock Grid.Row="0" Text="Plots" />
						<TreeView x:Name="tvMctcPlots"
								  Grid.Row="1"
								  ItemsSource="{Binding MctcPlotNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<TextBlock Text="{Binding Label}"/>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>


				</Grid>
			</Border>

			<GridSplitter Grid.Column="1"
			  ResizeDirection="Columns"/>

			<!-- Main Pane -->
			<Border Grid.Column="2" Classes="Panels" >
				<TabControl x:Name="TabControl">
					<TabItem Header="Tab 1">
						<TextBlock Margin="5">This is tab 1 content</TextBlock>
					</TabItem>
					<TabItem Header="Tab 2">
						<TextBlock Margin="5">This is tab 2 content</TextBlock>
					</TabItem>
					<TabItem Header="Tab 3">
						<TextBlock Margin="5">This is tab 3 content</TextBlock>
					</TabItem>
				</TabControl>
			</Border>
		</Grid>
	</DockPanel>

</Window>
