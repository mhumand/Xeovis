<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
		MinHeight="500"
		MinWidth="700"
        x:Class="Xeovis.UI.Views.MainWindow"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		xmlns:vm="using:Xeovis.UI.ViewModels"
		xmlns:vmModels="using:Xeovis.UI.Models"
        x:DataType="vm:MainWindowViewModel"
        Title="Xeovis"
		ShowInTaskbar="True"
		WindowState="Maximized">

	<Window.Styles>
		<StyleInclude Source="/Views/Styles/Dialogs.axaml"/>
		<StyleInclude Source="/Views/Styles/TabItems.axaml"/>

		<Style Selector="TextBlock.Primary">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TreeView">
			<Setter Property="Margin" Value="0 2"/>
		</Style>

		<Style Selector="TreeViewItem"  x:DataType="vmModels:TreeNode">
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Margin" Value="2"/>
		</Style>

		<Style Selector="Border.Panels">
			<Setter Property="BorderBrush" Value="LightGray"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="2"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style Selector="Button.Tabs">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Content" Value="✕"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="StackPanel.Tabs">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Spacing" Value="5"/>
		</Style>

		<Style Selector="Image.Icon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</Window.Styles>

	<DockPanel>
		<!-- Main Menu -->
		<Grid x:Name="MenuGrid"
			  DockPanel.Dock="Top"
			  RowDefinitions="*">
			<userControls:MainMenu x:Name="mainMenu" />
		</Grid>

		<Grid DockPanel.Dock="Top" x:Name="mainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220" MinWidth="150" MaxWidth="400" />
				<ColumnDefinition Width="5" MinWidth="5" />
				<ColumnDefinition Width="*" MinWidth="500" />
			</Grid.ColumnDefinitions>

			<!-- Tree Lists -->
			<Border Grid.Column="0" Classes="Panels" x:Name="borderTreeLists">
				<Grid x:Name="TreeGrid">
					<Grid.RowDefinitions>
						<RowDefinition Height="1*" MinHeight="200"/>
						<RowDefinition Height="5" MinHeight="5"/>
						<RowDefinition Height="1*" MinHeight="200"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="5 2" RowDefinitions="25,*">
						<StackPanel Grid.Row="0" Classes="Tabs">
							<Image Classes="Icon" Source="/Assets/MainMenu/experiment.png"/>
							<TextBlock Classes="Primary" Text="Experiments" />
						</StackPanel>

						<TreeView x:Name="tvExperiments"
								  Grid.Row="1"
								  ItemsSource="{Binding ExperimentNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<TextBlock Text="{Binding Label}"/>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>

					<GridSplitter Grid.Row="1"
								  ResizeDirection="Rows"/>

					<Grid Grid.Row="2" Margin="5 2" RowDefinitions="25,*">
						<StackPanel Grid.Row="0" Classes="Tabs">
							<Image Classes="Icon" Source="/Assets/MainMenu/bundle.png"/>
							<TextBlock Classes="Primary" Text="MCTC Bundles" />
						</StackPanel>
						<TreeView x:Name="tvMctcBundles"
								  Grid.Row="1"
								  ItemsSource="{Binding MctcBundleNodes}">
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
									<TextBlock Text="{Binding Label}"/>
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Grid>

				</Grid>
			</Border>

			<GridSplitter Grid.Column="1"
						  x:Name="splitterVertical"
						  ResizeDirection="Columns"/>

			<!-- Main Pane -->
			<Border Grid.Column="2" Padding="0" Classes="Panels" >
				<TabControl x:Name="tabControl"
							ItemsSource="{Binding TabControls}">

					<TabControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Classes="Tabs" IsVisible="{Binding IsVisible}">
								<TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
								<Button x:Name="btnCloseTab"
										Classes="Tabs"
										Tag="{Binding Id}"
										Click="btnCloseTab_Click"
										IsVisible="{Binding CanBeRemoved}"/>
							</StackPanel>
						</DataTemplate>
					</TabControl.ItemTemplate>

					<TabControl.ContentTemplate>
						<DataTemplate DataType="vm:TabControlViewModelBase">
							<UserControl Content="{Binding OwnerTabControl}"
										 IsVisible="{Binding IsVisible}"/>
						</DataTemplate>
					</TabControl.ContentTemplate>

				</TabControl>
			</Border>
		</Grid>
	</DockPanel>

</Window>
