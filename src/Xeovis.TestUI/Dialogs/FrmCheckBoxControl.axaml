<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
		Width="500"
		Height="600"
        x:Class="Xeovis.TestUI.FrmCheckBoxControl"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
        Title="FrmCheckBoxControl"
		WindowStartupLocation="CenterScreen"
		ShowInTaskbar="False"
		Icon="/XeovisLogo.png">

	<StackPanel Margin="10" Spacing="10">

		<userControls:CheckBoxControl x:Name="cbcBox1" />
		<userControls:CheckBoxControl x:Name="cbcBox2" />
		<userControls:CheckBoxControl x:Name="cbcBox3" />

		<TextBlock x:Name="txt1" />
		<TextBlock x:Name="txt2" />
		<TextBlock x:Name="txt3" />
	</StackPanel>
</Window>
