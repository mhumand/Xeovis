<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
        x:Class="Xeovis.TestUI.FrmLabelListControl"
        Title="FrmLabelListControl"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		Width="400"
		Height="400"
		WindowStartupLocation="CenterScreen"
		ShowInTaskbar="False"
		Icon="/XeovisLogo.png">

	<StackPanel Margin="10" Spacing="10">
		<userControls:LabelListControl x:Name="llcList" Height="300"/>
		
		<TextBlock x:Name="tbSelectedItem" />
	</StackPanel>
</Window>
