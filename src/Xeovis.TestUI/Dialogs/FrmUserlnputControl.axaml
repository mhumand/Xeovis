<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Xeovis.TestUI.FrmUserInputControl"
        Title="FrmUserInputControl"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
		Width="400"
		Height="450"
		WindowStartupLocation="CenterScreen">


	<StackPanel Margin="10" Spacing="10">

		<userControls:LabelInputControl x:Name="licSimpleText"/>
		<userControls:LabelInputControl x:Name="licSimpleTextReadOnly"/>
		<userControls:LabelInputControl x:Name="licNumber"/>

	</StackPanel>

</Window>
