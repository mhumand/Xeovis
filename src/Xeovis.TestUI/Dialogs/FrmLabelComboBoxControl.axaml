<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"
        x:Class="Xeovis.TestUI.FrmLabelComboBoxControl"
        Title="FrmLabelComboBoxControl"
		Width="300"
		Height="450"
		WindowStartupLocation="CenterScreen"
		ShowInTaskbar="False"
		Icon="/XeovisLogo.png">


	<StackPanel Margin="10" Spacing="10">

		<userControls:LabelComboBoxControl x:Name="lcbc1" />
		<userControls:LabelComboBoxControl x:Name="lcbc2" />
		
		<TextBlock x:Name="txt1"/>
		<TextBlock x:Name="txt2"/>
	</StackPanel>
</Window>
