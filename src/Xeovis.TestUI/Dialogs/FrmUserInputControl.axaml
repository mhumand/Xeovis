<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="Xeovis.TestUI.FrmUserInputControl"
		xmlns:userControls="clr-namespace:Xeovis.UI;assembly=Xeovis.UI"        Title="FrmUserInputControl"
		Width="500"
		Height="450"
		WindowStartupLocation="CenterScreen">

	<Grid x:Name="grid" Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>

		<userControls:LabelInputControl x:Name="licSimpleText" Grid.Row="0" Label="Simple Text" Value="simple" />
		<userControls:LabelInputControl x:Name="licSimpleTextReadOnly" Grid.Row="1" Label="Read-only Simple Text" Value="So simple" IsReadOnly="True"/>
		<userControls:LabelInputControl x:Name="licNumber" Grid.Row="2" Label="Number"   Value="4565"/>
	</Grid>

</Window>
