<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="Xeovis.TestUI.MainWindow"
        Title="Xeovis.TestUI"
		Width="400"
		Height="500"
		WindowStartupLocation="CenterScreen">

	<Window.Styles>
		<Style Selector="Button">
			<Setter Property="Width" Value="300" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
	</Window.Styles>

	<StackPanel Margin="20" Spacing="15">
		<Button x:Name="btnLabelInputControl"
				Content="Label Input Control"
				Click="btnLabelInputControl_Click" />

		<Button x:Name="btnLabelListControl"
				Content="Label List Control"
				Click="btnLabelListControl_Click" />

		<Button x:Name="btnCheckBoxControl"
				Content="CheckBox Control"
				Click="btnCheckBoxControl_Click" />

		<Button x:Name="btnLabelComboBoxControl"
				Content="Label ComboBox Control"
				Click="btnLabelComboBoxControl_Click" />

		<Button x:Name="btnLabelSpinnerControl"
				Content="Label Spinner Control"
				Click="btnLabelSpinnerControl_Click" />

		<Button x:Name="btnLabelBrowseDirectoryControl"
				Content="Label Browse Directory Control"
				Click="btnLabelBrowseDirectoryControl_Click" />

		<Button x:Name="btnTableControl"
				Content="Table Control"
				Click="btnTableControl_Click" />

		<Button x:Name="btnChartControl"
				Content="Chart Control"
				Click="btnChartControl_Click" />

		<Button x:Name="btnRenameDialog"
				Content="Rename Dialog (taken name = Plot)"
				Click="btnRenameDialog_Click" />

	</StackPanel>
</Window>
