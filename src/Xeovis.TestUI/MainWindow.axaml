<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="Xeovis.TestUI.MainWindow"
        Title="Xeovis.TestUI"
		Width="400"
		Height="500"
		WindowStartupLocation="CenterScreen">

	<Grid Height="400" VerticalAlignment="Center">
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Button Grid.Row="0" x:Name="btnLabelInputControl" Content="Label Input Control" HorizontalAlignment="Center" Width="200" Height="40"
				HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Button_Click" />
	</Grid>
</Window>
